# Application
APP_ENV=development
LOG_LEVEL=INFO

# Google Places API (used in Phase 1)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=10
GOOGLE_PLACES_PAGE_SIZE=20

# OpenAI Responses API (used in Phase 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

# Local persistence (used in Phase 2 / Phase 4 demos)
LEAD_DB_PATH=data/leads.sqlite3
DEMO_OUTPUT_PATH=data/demos

# Shareable demo deployment (optional; used in M4.5)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_TIMEOUT_SECONDS=30
